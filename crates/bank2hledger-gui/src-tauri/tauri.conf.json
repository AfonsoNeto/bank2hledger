{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bank2hledger-gui",
  "version": "0.1.0",
  "identifier": "dev.afonsoneto.bank2hledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bank2hledger",
        "width": 1080,
        "height": 720,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "windowEffects": {
          "effects": ["mica", "acrylic", "blur"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Finance",
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
