{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the bank2hledger main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "description": "Allow opening the project documentation URLs only",
      "allow": [
        { "url": "https://github.com/AfonsoNeto/bank2hledger*" },
        { "url": "https://hledger.org*" }
      ]
    }
  ]
}
